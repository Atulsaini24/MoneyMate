{
  "name": "MoneyMate",
  "short_name": "MoneyMate",
  "description": "Track spending, plan budgets and see what's safe to spend today.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F3F5F2",
  "theme_color": "#F3F5F2",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "url": "/?action=add-expense",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Scan receipt",
      "url": "/?action=scan",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Import bank SMS",
      "url": "/import",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "categories": [
    "finance",
    "productivity"
  ]
}
